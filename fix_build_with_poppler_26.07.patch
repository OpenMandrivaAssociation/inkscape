 #include <poppler/UTF.h>
 
+#if POPPLER_CHECK_VERSION(26, 7, 0)
+#define _POPPLER_STREAM_GET_DICT(obj) (obj).getStream()->getDict()
+#define _POPPLER_ARRAY_GET_NF(obj, i) (obj).getArray()->getNF(i)
+#else
+#define _POPPLER_STREAM_GET_DICT(obj) (obj).streamGetDict()
+#define _POPPLER_ARRAY_GET_NF(obj, i) (obj).arrayGetNF(i)
+#endif
+
 #if POPPLER_CHECK_VERSION(26, 6, 0)
 #define _POPPLER_GET_GRAY(color, gray) getGray(color, gray)
 #define _POPPLER_GET_RGB(color, rgb) getRGB(color, rgb)
